# Generates a C++ source file that embeds every file under WEB_DIR.
# Usage: cmake -DWEB_DIR=<dir> -DOUT=<file.cpp> -P embed_assets.cmake
file(GLOB_RECURSE FILES RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
list(SORT FILES)

set(BODY "// GENERATED by cmake/embed_assets.cmake from web/. Do not edit.\n")
string(APPEND BODY "#include \"server/assets.h\"\n#include <cstring>\n\nnamespace exile::server {\nnamespace {\n")

set(TABLE "")
set(I 0)
foreach(F ${FILES})
    file(READ "${WEB_DIR}/${F}" HEX HEX)
    string(LENGTH "${HEX}" HEXLEN)
    math(EXPR SIZE "${HEXLEN} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    if(F MATCHES "\\.html$")
        set(MIME "text/html; charset=utf-8")
    elseif(F MATCHES "\\.css$")
        set(MIME "text/css; charset=utf-8")
    elseif(F MATCHES "\\.js$")
        set(MIME "text/javascript; charset=utf-8")
    elseif(F MATCHES "\\.svg$")
        set(MIME "image/svg+xml")
    elseif(F MATCHES "\\.png$")
        set(MIME "image/png")
    elseif(F MATCHES "\\.json$")
        set(MIME "application/json; charset=utf-8")
    elseif(F MATCHES "\\.txt$")
        set(MIME "text/plain; charset=utf-8")
    else()
        message(FATAL_ERROR "embed_assets: no MIME type for ${F}")
    endif()
    string(APPEND BODY "const unsigned char kData${I}[] = {${BYTES}0x00};\n")
    string(APPEND TABLE "    {\"/${F}\", \"${MIME}\", kData${I}, ${SIZE}},\n")
    math(EXPR I "${I} + 1")
endforeach()

string(APPEND BODY "const Asset kAssets[] = {\n${TABLE}};\n}  // namespace\n\n")
string(APPEND BODY "const Asset* findAsset(std::string_view path) {\n    if (path == \"/\") path = \"/index.html\";\n    for (const Asset& a : kAssets)\n        if (path == a.path) return &a;\n    return nullptr;\n}\n\n}  // namespace exile::server\n")
file(WRITE "${OUT}" "${BODY}")
