[binaries]
c = '@EXILE_ARCH@-serenity-clang'
cpp = '@EXILE_ARCH@-serenity-clang++'
ar = 'llvm-ar'
ranlib = 'llvm-ranlib'
pkgconfig = 'pkg-config'

[properties]
sys_root = '@EXILE_BUILD_DIR@/Root'
needs_exe_wrapper = true

[host_machine]
system = 'serenity'
cpu_family = '@EXILE_ARCH@'
cpu = '@EXILE_ARCH@'
endian = 'little'
